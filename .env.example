# Copy this file to .env and fill in real values.
# Never commit .env — it is listed in .gitignore.

# OpenAI
OPENAI_API_KEY=replace-with-openai-api-key
MODEL_NAME=gpt-4o

# PGVector — collection containing the Garifuna books and lexicon documents.
# REQUIRED VALUE: document_collection
# This collection holds DICCIONARIO GARIFUNA (4,972 chunks), LIBRO SERIE I
# (467 chunks), and LIBRO GARIFUNA II (376 chunks). Using any other value
# will cause the chatbot to query a different collection and lose access
# to both books.
COLLECTION_NAME=document_collection

# PostgreSQL
DB_USER=replace-with-db-user
DB_PASS=replace-with-db-password
DB_HOST=replace-with-db-host
DB_PORT=5432
DB_NAME=replace-with-db-name

# Admin API key — required for the /knowledge-gaps/* endpoints.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Passed as X-Admin-Key header from the frontend Next.js proxy (server-side only).
ADMIN_API_KEY=replace-with-a-strong-random-key
